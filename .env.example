# ==============================================================================
# CostGuard Environment Configuration
# ==============================================================================

# Path to the SQLite pricing cache file
COSTGUARD_CACHE_PATH=pricing_cache.db

# Live Azure Retail Prices API Base URL
COSTGUARD_AZURE_API_URL=https://prices.azure.com/api/retail/prices

# HTTP request timeout in seconds when querying Azure Retail Prices API
COSTGUARD_API_TIMEOUT=10.0

# Default monthly increase threshold in dollars before triggering circuit breaker
COSTGUARD_MAX_INCREASE=50.0

# Default ISO currency code (USD, EUR, GBP, CAD, AUD, etc.)
COSTGUARD_CURRENCY=USD

# FastApi Web Server Port & Host
COSTGUARD_SERVER_HOST=0.0.0.0
COSTGUARD_SERVER_PORT=8000
